# Base URL of the MumWell API. Leave empty in development (Vite proxies /api to the server)
# and when the server serves this app itself. Set it when the API is on another domain,
# e.g. VITE_API_URL=https://api.mumwell.org
VITE_API_URL=

# Where the dev server proxies /api (default http://localhost:5100).
# VITE_DEV_API_PROXY=http://localhost:5100

# Vapi (voice consultations) — public web key and optional assistant id.
VITE_VAPI_PUBLIC_KEY=
