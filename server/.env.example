# ---------- Server ----------
NODE_ENV=development
PORT=5100
# Comma-separated list of front-end origins allowed to call the API.
CLIENT_URL=http://localhost:3000
# Set to true to serve client/dist from this server (single-host deployment).
SERVE_CLIENT=false

# ---------- Databases ----------
# MongoDB: accounts, sessions, AI chat, mood, EPDS results, activities.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mumwell
# Neon Postgres: wellness profile, 90-day program, wellness check-ins,
# voice consultations, reminder settings. Optional — those features return 503 without it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ---------- Auth ----------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- AI provider (set one) ----------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: force a provider when both keys are set (gemini | openrouter).
LLM_PROVIDER=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Hours before an AI chat session is automatically deleted. 0 = keep forever.
CHAT_SESSION_TTL_HOURS=24

# ---------- Email (password reset + reminders) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_USER=
MAIL_PASS=
# Defaults to MAIL_USER.
MAIL_FROM=

# Crisis escalation: when a user shows signs of suicide, self-harm or risk to her baby,
# email this inbox with her details. Leave empty to disable. Needs the SMTP settings above.
CRISIS_ALERT_EMAIL=
# Repeat alerts for the same user within this many minutes are logged but not re-emailed.
CRISIS_ALERT_COOLDOWN_MINUTES=30

# ---------- Daily reminder emails ----------
# Run the every-minute scheduler inside this process (use on a single always-on instance)...
ENABLE_REMINDER_CRON=false
# ...or call POST /api/notifications/run from an external scheduler with header x-cron-secret.
CRON_SECRET=

# ---------- Logging ----------
LOG_LEVEL=info
LOG_TO_FILE=false
